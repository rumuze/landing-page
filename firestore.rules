rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUser().role == "admin";
    }

    function isAdminUserId(userId) {
      return userId is string
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.role == "admin";
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().size() == keys.size();
    }

    function isNonEmptyString(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isValidEmail(value) {
      return isNonEmptyString(value, 3, 320)
        && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isValidMessageStatus(status) {
      return status == "new" || status == "seen" || status == "replied";
    }

    function isMessageOwner() {
      return isSignedIn()
        && resource.data.userId != null
        && request.auth.uid == resource.data.userId;
    }

    function hasImmutableMessageFields() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.userPhoto == resource.data.userPhoto
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidGuestMessageCreate() {
      return request.resource.data.userId == null
        && request.resource.data.userPhoto == null;
    }

    function isValidSignedInMessageCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && isOptionalString(request.resource.data.userPhoto, 2048);
    }

    function isValidMessageCreate() {
      return hasOnlyKeys(
          request.resource.data,
          [
            "userId",
            "userName",
            "userEmail",
            "userPhoto",
            "message",
            "reply",
            "status",
            "createdAt",
            "repliedAt"
          ]
        )
        && (isValidGuestMessageCreate() || isValidSignedInMessageCreate())
        && isNonEmptyString(request.resource.data.userName, 1, 120)
        && isNonEmptyString(request.resource.data.userEmail, 3, 320)
        && request.resource.data.userEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && isNonEmptyString(request.resource.data.message, 1, 5000)
        && request.resource.data.reply == null
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time
        && request.resource.data.repliedAt == null;
    }

    function isValidSeenUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(["status"])
        && resource.data.status == "new"
        && request.resource.data.status == "seen"
        && request.resource.data.reply == resource.data.reply
        && request.resource.data.repliedAt == resource.data.repliedAt;
    }

    function isValidReplyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(["reply", "status", "repliedAt"])
        && resource.data.status != "replied"
        && resource.data.reply == null
        && resource.data.repliedAt == null
        && isNonEmptyString(request.resource.data.reply, 1, 5000)
        && request.resource.data.status == "replied"
        && request.resource.data.repliedAt == request.time;
    }

    function isValidAdminMessageUpdate() {
      return hasImmutableMessageFields()
        && (isValidSeenUpdate() || isValidReplyUpdate());
    }

    function isValidUserCreate(userId) {
      return hasOnlyKeys(
          request.resource.data,
          ["uid", "email", "name", "role", "createdAt", "photoURL", "lastLoginAt", "messagesCount"]
        )
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "user"
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.messagesCount == 0
        && isNonEmptyString(request.resource.data.name, 1, 120)
        && isNonEmptyString(request.resource.data.email, 3, 320)
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && isOptionalString(request.resource.data.photoURL, 2048);
    }

    function isValidUserUpdate(userId) {
      return isCurrentUser(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.messagesCount == resource.data.messagesCount
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.lastLoginAt == resource.data.lastLoginAt
          || request.resource.data.lastLoginAt == request.time
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["email", "name", "photoURL", "lastLoginAt"])
        && isNonEmptyString(request.resource.data.name, 1, 120)
        && isNonEmptyString(request.resource.data.email, 3, 320)
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && isOptionalString(request.resource.data.photoURL, 2048);
    }

    function isValidAdminUserUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["role"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.lastLoginAt == resource.data.lastLoginAt
        && request.resource.data.messagesCount == resource.data.messagesCount
        && (request.resource.data.role == "admin" || request.resource.data.role == "user");
    }

    function isValidNotificationCreate() {
      return request.resource.data.keys().hasAll(["userId", "type", "isRead", "createdAt", "threadId"])
        && request.resource.data.type in ["message", "reply"]
        && request.resource.data.isRead == false
        && request.resource.data.createdAt == request.time
        && isNonEmptyString(request.resource.data.threadId, 1, 128);
    }

    function isValidNotificationUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(["isRead"])
        && request.resource.data.isRead == true
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type
        && request.resource.data.threadId == resource.data.threadId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidThreadStatus(status) {
      return status == "open" || status == "closed";
    }

    function getThread(threadId) {
      return get(/databases/$(database)/documents/threads/$(threadId));
    }

    function getThreadAfter(threadId) {
      return getAfter(/databases/$(database)/documents/threads/$(threadId));
    }

    function hasImmutableThreadFields() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.userPhoto == resource.data.userPhoto
        && request.resource.data.isGuest == resource.data.isGuest
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidThreadCreate() {
      return hasOnlyKeys(
          request.resource.data,
          [
            "userId",
            "userName",
            "userEmail",
            "userPhoto",
            "isGuest",
            "status",
            "lastMessage",
            "createdAt",
            "updatedAt"
          ]
        )
        && (
          (
            request.auth == null
            && request.resource.data.userId == null
            && request.resource.data.isGuest == true
            && request.resource.data.userPhoto == null
          )
          || (
            isSignedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.userEmail == request.auth.token.email
            && request.resource.data.isGuest == false
            && isOptionalString(request.resource.data.userPhoto, 2048)
          )
        )
        && isNonEmptyString(request.resource.data.userName, 1, 120)
        && isValidEmail(request.resource.data.userEmail)
        && request.resource.data.status == "open"
        && isNonEmptyString(request.resource.data.lastMessage, 1, 5000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidThreadMessageUpdate() {
      return hasImmutableThreadFields()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["lastMessage", "updatedAt"])
        && isNonEmptyString(request.resource.data.lastMessage, 1, 5000)
        && request.resource.data.status == resource.data.status
        && request.resource.data.updatedAt == request.time
        && (
          isAdmin()
          || (
            isCurrentUser(resource.data.userId)
            && resource.data.status == "open"
          )
        );
    }

    function isValidThreadStatusUpdate() {
      return hasImmutableThreadFields()
        && isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.lastMessage == resource.data.lastMessage
        && isValidThreadStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time;
    }

    function isValidThreadChatMessageCreate(threadId) {
      let threadData = getThreadAfter(threadId).data;
      return existsAfter(/databases/$(database)/documents/threads/$(threadId))
        && hasOnlyKeys(
          request.resource.data,
          ["senderId", "senderRole", "text", "createdAt"]
        )
        && isNonEmptyString(request.resource.data.text, 1, 5000)
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.senderRole == "admin"
            && isAdmin()
            && request.resource.data.senderId == request.auth.uid
          )
          || (
            request.resource.data.senderRole == "user"
            && threadData.status == "open"
            && (
              (
                request.auth == null
                && threadData.userId == null
                && request.resource.data.senderId == null
                && !exists(/databases/$(database)/documents/threads/$(threadId))
              )
              || (
                isCurrentUser(threadData.userId)
                && threadData.userId != null
                && request.resource.data.senderId == request.auth.uid
              )
            )
          )
        );
    }

    function isValidThreadNotificationCreate(threadId) {
      let threadData = getThreadAfter(threadId).data;
      return existsAfter(/databases/$(database)/documents/threads/$(threadId))
        && isAdmin()
        && hasOnlyKeys(
          request.resource.data,
          ["userId", "type", "isRead", "createdAt", "threadId"]
        )
        && isNonEmptyString(request.resource.data.userId, 1, 128)
        && request.resource.data.threadId == threadId
        && request.resource.data.type == "reply"
        && threadData.userId != null
        && request.resource.data.userId == threadData.userId
        && request.resource.data.isRead == false
        && request.resource.data.createdAt == request.time
        && !isAdminUserId(request.resource.data.userId);
    }

    match /messages/{messageId} {
      allow create: if false;
      allow read: if isAdmin() || isMessageOwner();
      allow update, delete: if false;
    }

    match /threads/{threadId} {
      allow create: if isValidThreadCreate();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if isValidThreadMessageUpdate() || isValidThreadStatusUpdate();
      allow delete: if false;
    }

    match /threads/{threadId}/messages/{messageId} {
      allow read: if isAdmin() ||
        (
          isSignedIn()
          && request.auth.uid == getThread(threadId).data.userId
        );
      allow create: if isValidThreadChatMessageCreate(threadId);
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isCurrentUser(userId) || isAdmin();
      allow create: if isSignedIn() && isValidUserCreate(userId);
      allow update: if (isSignedIn() && isValidUserUpdate(userId)) || isValidAdminUserUpdate();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if false;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && isValidNotificationUpdate();
      allow delete: if false;
    }
  }
}
