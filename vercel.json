{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|svg|ico|woff2|woff|ttf)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/why-rumuze",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ar/why-rumuze",
      "destination": "/ar/about",
      "permanent": true
    },
    {
      "source": "/enterprise-framework",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/ar/enterprise-framework",
      "destination": "/ar/services",
      "permanent": true
    },
    {
      "source": "/methodology",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ar/methodology",
      "destination": "/ar/about",
      "permanent": true
    },
    {
      "source": "/architecture-principles",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ar/architecture-principles",
      "destination": "/ar/about",
      "permanent": true
    },
    {
      "source": "/engineering-standards",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ar/engineering-standards",
      "destination": "/ar/about",
      "permanent": true
    },
    {
      "source": "/slo-framework",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/ar/slo-framework",
      "destination": "/ar/services",
      "permanent": true
    },
    {
      "source": "/multilingual-systems",
      "destination": "/services/web-development",
      "permanent": true
    },
    {
      "source": "/ar/multilingual-systems",
      "destination": "/ar/services/web-development",
      "permanent": true
    },
    {
      "source": "/knowledge-graph-architecture",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/ar/knowledge-graph-architecture",
      "destination": "/ar/services",
      "permanent": true
    },
    {
      "source": "/enterprise-web-development",
      "destination": "/services/web-development",
      "permanent": true
    },
    {
      "source": "/ar/enterprise-web-development",
      "destination": "/ar/services/web-development",
      "permanent": true
    },
    {
